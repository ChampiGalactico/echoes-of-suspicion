  m_Script: {fileID: 11500000, guid: a27f7163dab90ef4eb0244c1533660b9, type: 3}
  m_Name: BateriaManual
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  DefaultFont: {fileID: 0}
  VerticalAlignment: 0
  Sections:
  - Type: 0
    Text: "SISTEMA EL\xC9CTRICO / BATER\xCDA"
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 1
    Text: "<color=#FF8C00>[!] ALERTA: PRIORIDAD ALTA</color>"
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 2
    Text: "Los terminales de la bater\xEDa presentan acumulaci\xF3n severa de \xF3xido
      en los bornes. La resistencia el\xE9ctrica supera el umbral de arranque. El
      voltaje medido es de 2.1V cuando el m\xEDnimo operativo es 12V."
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 0
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 2
    Text: "El sistema de encendido no recibe corriente suficiente. Los bornes est\xE1n
      soldados por corrosi\xF3n y deben ser liberados mec\xE1nicamente para restaurar
      el contacto."
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 0
    Text: 'HERRAMIENTA: DESTORNILLADOR'
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 2
    Text: "Aflojar las tuercas de sujeci\xF3n de ambos bornes. Retirar dep\xF3sitos
      de \xF3xido de las superficies de contacto. Reconectar terminales y verificar
      continuidad el\xE9ctrica."
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 4
    Text: "Manual t\xE9cnico del Gu\xEDa \xB7 Taller Mec\xE1nico \xB7 Uso interno"
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 0
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  ContentImage: {fileID: 0}
  InteractionPrompt: Leer manual
