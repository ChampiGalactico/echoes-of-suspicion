  m_Script: {fileID: 11500000, guid: a27f7163dab90ef4eb0244c1533660b9, type: 3}
  m_Name: CombustibleManual
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  DefaultFont: {fileID: 0}
  VerticalAlignment: 0
  Sections:
  - Type: 0
    Text: SISTEMA DE COMBUSTIBLE
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 1
    Text: "<color=#FF3333>[!] ALERTA: PRIORIDAD M\xC1XIMA</color>"
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 2
    Text: "La l\xEDnea principal de suministro presenta una ca\xEDda total de presi\xF3n.
      El inyector no recibe flujo y la bomba de combustible gira en vac\xEDo. Sin
      suministro estable, el motor no alcanza la mezcla aire-combustible necesaria
      para la ignici\xF3n."
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 0
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 2
    Text: "Se detect\xF3 residuo de corrosi\xF3n en la v\xE1lvula de retorno. El
      tanque original est\xE1 comprometido y no admite reparaci\xF3n parcial. Requiere
      reemplazo completo de la unidad."
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 0
    Text: 'HERRAMIENTA: TANQUE DE COMBUSTIBLE'
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 2
    Text: "Retirar unidad da\xF1ada del soporte inferior. Instalar tanque de reemplazo
      y asegurar conexi\xF3n a la l\xEDnea de alimentaci\xF3n. Purgar aire del circuito
      antes de intentar arranque."
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 4
    Text: "Manual t\xE9cnico del Gu\xEDa \xB7 Taller Mec\xE1nico \xB7 Uso interno"
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 0
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  ContentImage: {fileID: 0}
  InteractionPrompt: Leer manual
