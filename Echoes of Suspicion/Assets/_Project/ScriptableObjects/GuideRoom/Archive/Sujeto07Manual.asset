  m_Name: Sujeto07Manual
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  DefaultFont: {fileID: 0}
  VerticalAlignment: 0
  Sections:
  - Type: 0
    Text: "SUJETO 07 — INFORME DE CONTENCI\xD3N"
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 1
    Text: "[!] NIVEL DE AMENAZA: EXTREMO \xB7 CLASIFICADO"
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 2
    Text: "Organismo recuperado durante excavaci\xF3n del Sector C-7. Origen desconocido. Tejido muscular an\xF3malo: densidad 4.2x superior a la humana. Ritmo card\xEDaco registrado: 340 BPM en reposo."
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 0
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 2
    Text: "COMPORTAMIENTO: Reacciona a est\xEDmulos sonoros y luminosos. Velocidad de desplazamiento superior a un humano adulto. Actividad incrementada en periodos de oscuridad. No responde a sedantes convencionales desde el d\xEDa 14."
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 0
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 2
    Text: "D\xCDA 31 — \xDALTIMA ENTRADA: Contenci\xF3n comprometida en el ala este. Dos t\xE9cnicos no reportados. C\xE1maras del pasillo B muestran actividad a las 03:14. Despu\xE9s de eso... est\xE1tica."
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 0
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 1
    Text: "PROTOCOLO: NO CONFRONTAR"
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 0
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 2
    Text: "En caso de avistamiento: permanecer inm\xF3vil. No correr. Evitar contacto visual directo. Si se activa... no hay protocolo documentado que garantice supervivencia."
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 4
    Text: "Laboratorio de Investigaci\xF3n \xB7 Nivel de Acceso: RESTRINGIDO \xB7 Documento interno"
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 0
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  ContentImage: {fileID: 0}
  InteractionPrompt: Leer informe
