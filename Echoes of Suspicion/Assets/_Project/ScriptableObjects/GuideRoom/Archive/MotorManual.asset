  m_Script: {fileID: 11500000, guid: a27f7163dab90ef4eb0244c1533660b9, type: 3}
  m_Name: MotorManual
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  DefaultFont: {fileID: 0}
  VerticalAlignment: 0
  Sections:
  - Type: 0
    Text: "BLOQUE DEL MOTOR"
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 1
    Text: "<color=#FFD700>[!] ALERTA: PRIORIDAD MEDIA</color>"
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 2
    Text: "El cableado del sistema de ignici\xF3n presenta da\xF1o por exposici\xF3n. Varios tramos del arn\xE9s principal est\xE1n pelados y hacen contacto intermitente con la carcasa met\xE1lica, generando cortocircuitos espor\xE1dicos."
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 0
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 2
    Text: "El bloque no logra completar el ciclo de ignici\xF3n. La chispa se disipa por los tramos expuestos antes de llegar a la buj\xEDa. Se requiere aislamiento inmediato de las secciones comprometidas."
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 0
    Text: "HERRAMIENTA: CINTA AISLANTE ROJA"
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 2
    Text: "Envolver cada tramo expuesto del arn\xE9s con m\xEDnimo tres vueltas de cinta. Asegurar que no quede cobre visible. Verificar que la cinta sea la ROJA (alta temperatura). La azul no soporta el calor del bloque."
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 1
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  - Type: 4
    Text: "Manual t\xE9cnico del Gu\xEDa \xB7 Taller Mec\xE1nico \xB7 Uso interno"
    Alignment: 257
    AnchorToBottom: 0
    ShowDivider: 0
    DividerColor: {r: 0.27, g: 0.27, b: 0.27, a: 1}
    Font: {fileID: 0}
    FontSizeOverride: -1
  ContentImage: {fileID: 0}
  InteractionPrompt: Leer manual
